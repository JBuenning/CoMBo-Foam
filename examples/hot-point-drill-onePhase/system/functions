temperatureTransport
{
    type            scalarTransport;
    libs            ( "libsolverFunctionObjects.so" );
    field           T;
    diffusivity     constant;
    D               0.15e-6;
    execteControl   timeStep;
    writeControl    writeTime;
}
drag
{
    type            forces;
    libs            ( "libforces.so" );
    patches         ( head shaft );
    rho             rhoInf;
    rhoInf          1000;
    CofR            ( 0 0 0 );
}

