FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(cellMotionU|cellMotionUFinal)"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-04;
        relTol          0;
    }

    T
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0;
        nCorrectors     1;
    }
    TFinal
    {
        $T
        relTol          0;
    }
}

PIMPLE
{
    moveMeshOuterCorrectors  false;
    nOuterCorrectors         1;
}

relaxationFactors
{
    equations
    {
        default 0;
        "(T|TFinal)"    1;
    }
}


