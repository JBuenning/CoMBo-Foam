FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          movingMesh;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.45;

deltaT          2e-3;

writeControl    timeStep;

writeInterval   3;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

libs
(
    "libcombo-foam-bc.so"
);


