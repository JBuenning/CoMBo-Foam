FoamFile
{
    format      ascii;
    class       pointVectorField;
    object      pointMotionU;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

#codeStream
{
    codeInclude
    #{
        #include "fvMesh.H"
    #};

    codeOptions
    #{
        -I$(LIB_SRC)/finiteVolume/lnInclude \
        -I$(LIB_SRC)/meshTools/lnInclude
    #};

    codeLibs
    #{
        -lfiniteVolume -lmeshTools
    #};

    code
    #{
        auto g = [] (scalar x) {
            return 0.5 - 0.2 * cos(0.5 * M_PI * x);
        };

        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());

        scalarField x(mesh.points().component(vector::X));
        scalarField y(mesh.points().component(vector::Y));
        scalarField s0 (y.size());
        forAll(s0, i) {
            s0[i] = g(x[i]);
        }
        // scaling bec. of melting in only normal direction
        scalarField f_n (cos(asin(0.1 * M_PI * sin(0.5 * M_PI * x))));
        const vectorField v( vector(0, 1, 0) * f_n * y / (s0 * s0) );

        writeEntry(os, "internalField", v);
    #};
};


boundaryField
{
    right
    {
        type            fixedNormalSlip;
        n               (1 0 0);
    }
    left
    {
        type            fixedNormalSlip;
        n               (-1 0 0);
    }
    bottom
    {
        type            uniformFixedValue;
        uniformValue    (0 0 0);
    }
    ice
    {
        type                onePhaseStefanMeltVelocity;
        kappaOverRhoH       1;
        URef                (0 0 0);
        linearUpwindBlendingFactor      0;
        laplaceSmoothing    true;
        value               uniform (0 0 0);
    }
    frontAndBack
    {
        type            empty;
    }
}


