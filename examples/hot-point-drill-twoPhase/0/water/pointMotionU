FoamFile
{
    format      ascii;
    class       pointVectorField;
    object      pointMotionU;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    outlet
    {
        type            fixedNormalSlip;
        n               (0 1 0);
    }
    shaft
    {
        type            uniformFixedValue;
        uniformValue    (0 0 0);
    }
    head
    {
        type            uniformFixedValue;
        uniformValue    (0 0 0);
    }
    back
    {
        type            wedge;
    }
    front
    {
        type            wedge;
    }
    water_to_ice
    {
        type            twoPhaseStefanMeltVelocity;
        rhoTimesH       334e6;
        kappa           0.56;
        URef            (0 5e-4 0);
        linearUpwindBlendingFactor  0.8;
        laplaceSmoothing            true;
        value           uniform (0 0 0);
    }
}


