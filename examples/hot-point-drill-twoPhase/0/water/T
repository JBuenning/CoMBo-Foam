FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 0;


boundaryField
{
    outlet
    {
        type            zeroGradient;
    }
    head
    {
        type            fixedValue;
        value           uniform 40;
    }
    shaft
    {
        type            zeroGradient;
    }
    back
    {
        type            wedge;
    }
    front
    {
        type            wedge;
    }
    water_to_ice
    {
        type            fixedValue;
        value           uniform 0;
    }
}


